---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Button from '../../../components/ui/Button.astro';
import { siteConfig, type Locale } from '../../../config/site';
import { isLocale, localePath } from '../../../utils/locale';
import { getUi, tLocalized, tLocalizedList } from '../../../i18n/ui';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return siteConfig.publishedLocales.flatMap((locale) =>
    courses.map((course) => ({
      params: { locale, slug: course.data.slug },
      props: { course },
    })),
  );
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) return Astro.redirect('/fr/');
const locale = localeParam as Locale;
const ui = getUi(locale);
const { course } = Astro.props;
const title = tLocalized(course.data.title, locale);
const summary = tLocalized(course.data.summary, locale);
const outcomes = tLocalizedList(course.data.outcomes, locale);
const prerequisites = tLocalized(course.data.prerequisites, locale);
---

<BaseLayout
  title={title}
  description={summary}
  locale={locale}
  path={`formations/${course.data.slug}`}
>
  <section class="bg-primary py-16 text-white lg:py-20 pt-nav">
    <Container>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-highlight">
        Niveau {course.data.level}
      </p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-bold sm:text-5xl">
        {title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-white/80">{summary}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {
          course.data.formats.map((format) => (
            <span class="rounded-md border border-white/20 px-3 py-1 text-sm capitalize text-white/85">
              {format}
            </span>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="bg-white py-16 lg:py-24">
    <Container class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <h2 class="font-display text-2xl font-semibold">Objectifs</h2>
        <ul class="mt-6 space-y-3 text-muted">
          {
            outcomes.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <h2 class="mt-12 font-display text-2xl font-semibold">Prérequis</h2>
        <p class="mt-4 text-muted">{prerequisites}</p>
        <p class="mt-6 text-sm text-muted">
          Durées, tarifs et calendriers exacts sont communiqués par le centre
          lors de l’inscription — ils ne sont pas inventés sur ce site.
        </p>
      </div>
      <aside class="border border-border bg-canvas p-8">
        <h2 class="font-display text-xl font-semibold">Demander une inscription</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Contactez Allemando pour un test de niveau et les prochaines sessions
          disponibles dans votre ville.
        </p>
        <div class="mt-6 flex flex-col gap-3">
          <Button href={localePath(locale, 'inscription')}>{ui.nav.enroll}</Button>
          <Button href={localePath(locale, 'centres')} variant="ghost">
            {ui.nav.centers}
          </Button>
        </div>
      </aside>
    </Container>
  </section>
</BaseLayout>
