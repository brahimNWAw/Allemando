---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import { siteConfig, type Locale } from '../../../config/site';
import { isLocale, localePath, publishedLocalePaths } from '../../../utils/locale'
import { getUi, tLocalized } from '../../../i18n/ui';

export function getStaticPaths() {
  return publishedLocalePaths();
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) return Astro.redirect('/fr/');
const locale = localeParam as Locale;
const ui = getUi(locale);
const courses = (await getCollection('courses'))
  .filter((c) => c.data.status === 'published')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={ui.nav.programs}
  description={ui.home.programsLead}
  locale={locale}
  path="formations"
>
  <section class="bg-canvas py-16 lg:py-24 pt-nav">
    <Container>
      <SectionHeading
        eyebrow="CECRL"
        title={ui.nav.programs}
        lead={ui.home.programsLead}
      />
      <div class="mt-12 space-y-4">
        {
          courses.map((course) => (
            <a
              href={localePath(locale, `formations/${course.data.slug}`)}
              class="flex flex-col gap-4 border border-border bg-white p-6 transition hover:border-primary/30 hover:shadow-soft sm:flex-row sm:items-center sm:justify-between"
            >
              <div class="flex items-start gap-4">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-md bg-primary font-display text-lg font-bold text-white">
                  {course.data.level}
                </span>
                <div>
                  <h2 class="font-display text-xl font-semibold">
                    {tLocalized(course.data.title, locale)}
                  </h2>
                  <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
                    {tLocalized(course.data.summary, locale)}
                  </p>
                </div>
              </div>
              <span class="text-sm font-semibold text-accent">
                {ui.common.learnMore} →
              </span>
            </a>
          ))
        }
      </div>
    </Container>
  </section>
</BaseLayout>
