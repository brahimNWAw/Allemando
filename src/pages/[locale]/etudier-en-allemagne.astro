---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import { siteConfig, type Locale } from '../../config/site';
import { isLocale, localePath, publishedLocalePaths } from '../../utils/locale'
import { getUi } from '../../i18n/ui';

export function getStaticPaths() {
  return publishedLocalePaths();
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) return Astro.redirect('/fr/');
const locale = localeParam as Locale;
const ui = getUi(locale);

const pillars = [
  {
    title: 'Études universitaires',
    text: 'Comprendre les prérequis linguistiques et les étapes générales d’un projet d’études en Allemagne.',
  },
  {
    title: 'Ausbildung',
    text: 'S’orienter vers les formations professionnelles duales et les niveaux de langue attendus.',
  },
  {
    title: 'Préparation aux examens',
    text: 'Se préparer aux examens de langue selon les sessions proposées par l’institut.',
  },
];
---

<BaseLayout
  title={ui.germany.title}
  description={ui.germany.lead}
  locale={locale}
  path="etudier-en-allemagne"
>
  <section class="bg-primary py-16 text-white lg:py-20 pt-nav">
    <Container>
      <SectionHeading
        eyebrow="Orientation"
        title={ui.germany.title}
        lead={ui.germany.lead}
        tone="light"
      />
    </Container>
  </section>

  <section class="bg-white py-16 lg:py-24">
    <Container>
      <div class="grid gap-8 md:grid-cols-3">
        {
          pillars.map((pillar) => (
            <article class="border-t-2 border-accent pt-5">
              <h2 class="font-display text-xl font-semibold">{pillar.title}</h2>
              <p class="mt-3 text-sm leading-relaxed text-muted">{pillar.text}</p>
            </article>
          ))
        }
      </div>
      <aside class="mt-12 border border-border bg-canvas p-8">
        <h2 class="font-display text-xl font-semibold">Transparence importante</h2>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
          Allemando peut vous accompagner sur la langue et l’orientation. Les
          décisions de visa, d’admission universitaire ou d’employeur restent
          exclusivement du ressort des autorités et institutions concernées.
          Aucune garantie de résultat n’est proposée sur ce site.
        </p>
        <div class="mt-6">
          <Button href={localePath(locale, 'inscription')}>{ui.nav.enroll}</Button>
        </div>
      </aside>
    </Container>
  </section>
</BaseLayout>
