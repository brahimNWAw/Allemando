---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Button from '../../../components/ui/Button.astro';
import { siteConfig, type Locale } from '../../../config/site';
import { isLocale, localePath, whatsappUrl } from '../../../utils/locale';
import { getUi, tLocalized } from '../../../i18n/ui';

export async function getStaticPaths() {
  const locations = await getCollection('locations');
  return siteConfig.publishedLocales.flatMap((locale) =>
    locations.map((location) => ({
      params: { locale, ville: location.data.slug },
      props: { location },
    })),
  );
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) return Astro.redirect('/fr/');
const locale = localeParam as Locale;
const ui = getUi(locale);
const { location } = Astro.props;
const summary = tLocalized(location.data.summary, locale);
const wa = whatsappUrl(
  siteConfig.contact.whatsappNumber,
  `${siteConfig.contact.whatsappMessage} Centre: ${location.data.city}`,
);
---

<BaseLayout
  title={`Allemando ${location.data.city}`}
  description={summary}
  locale={locale}
  path={`centres/${location.data.slug}`}
>
  <section class="relative overflow-hidden bg-brand-deep py-16 text-white lg:py-20 pt-nav">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,rgba(224,86,253,0.28),transparent_42%),linear-gradient(165deg,#5b21b6_0%,#3c006b_45%,#1a0033_100%)]"
      aria-hidden="true"
    >
    </div>
    <Container class="relative">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-highlight">
        Centre Allemando
      </p>
      <h1 class="mt-3 font-display text-4xl font-bold sm:text-5xl drop-shadow-[0_0_24px_rgba(224,86,253,0.35)]">
        {location.data.city}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-white/80">{summary}</p>
    </Container>
  </section>

  <section class="bg-white py-16 lg:py-24">
    <Container class="grid gap-10 lg:grid-cols-2">
      <div>
        {
          location.data.image && (
            <img
              src={location.data.image}
              alt={`Allemando ${location.data.city}`}
              class="mb-8 aspect-[9/16] max-h-[28rem] w-full rounded-2xl object-cover object-top shadow-soft ring-1 ring-brand/15 sm:max-h-[32rem]"
              loading="lazy"
            />
          )
        }
        <h2 class="font-display text-2xl font-semibold">Informations pratiques</h2>
        <dl class="mt-6 space-y-5 text-sm">
          <div>
            <dt class="font-semibold uppercase tracking-[0.12em] text-muted">
              Adresse
            </dt>
            <dd class="mt-2 text-base text-primary" dir="auto">
              {location.data.address ?? ui.common.needsConfirmation}
            </dd>
          </div>
          {
            location.data.phone && (
              <div>
                <dt class="font-semibold uppercase tracking-[0.12em] text-muted">
                  Téléphone
                </dt>
                <dd class="mt-2">
                  <a
                    href={`tel:${location.data.phone}`}
                    class="text-base font-semibold text-accent hover:text-accent-hover"
                    dir="ltr"
                  >
                    {location.data.phone}
                  </a>
                </dd>
              </div>
            )
          }
          <div>
            <dt class="font-semibold uppercase tracking-[0.12em] text-muted">
              Statut
            </dt>
            <dd class="mt-2 text-base text-primary">
              {
                location.data.verification === 'verified'
                  ? ui.common.verified
                  : ui.common.needsConfirmation
              }
            </dd>
          </div>
          <div>
            <dt class="font-semibold uppercase tracking-[0.12em] text-muted">
              Formations
            </dt>
            <dd class="mt-2 text-base text-muted">
              {tLocalized(location.data.programsNote, locale)}
            </dd>
          </div>
        </dl>
      </div>
      <aside class="rounded-2xl border border-border bg-canvas p-8">
        <h2 class="font-display text-xl font-semibold">
          {ui.common.contactCenter}
        </h2>
        <p class="mt-3 text-sm text-muted">
          Utilisez nos canaux officiels pour confirmer les horaires, le test de
          niveau et les prochaines sessions à {location.data.city}.
        </p>
        <div class="mt-6 flex flex-col gap-3">
          <Button href={localePath(locale, 'inscription')}>{ui.nav.enroll}</Button>
          {
            location.data.phone && (
              <Button href={`tel:${location.data.phone}`} variant="ghost">
                Appeler {location.data.phone}
              </Button>
            )
          }
          {
            location.data.mapsUrl && (
              <Button href={location.data.mapsUrl} variant="ghost" external>
                Voir sur Google Maps
              </Button>
            )
          }
          {
            wa && (
              <Button href={wa} variant="ghost" external>
                WhatsApp
              </Button>
            )
          }
        </div>
      </aside>
    </Container>
  </section>
</BaseLayout>
