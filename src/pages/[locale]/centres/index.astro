---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import { type Locale } from '../../../config/site';
import { isLocale, localePath, publishedLocalePaths } from '../../../utils/locale';
import { getUi, tLocalized } from '../../../i18n/ui';

export function getStaticPaths() {
  return publishedLocalePaths();
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) return Astro.redirect('/fr/');
const locale = localeParam as Locale;
const ui = getUi(locale);
const locations = (await getCollection('locations'))
  .filter((l) => l.data.status === 'published')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={ui.nav.centers}
  description={ui.home.centersLead}
  locale={locale}
  path="centres"
>
  <section class="bg-canvas py-16 lg:py-24 pt-nav">
    <Container>
      <SectionHeading
        eyebrow="Maroc"
        title={ui.nav.centers}
        lead={ui.home.centersLead}
      />
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {
          locations.map((location) => (
            <a
              href={localePath(locale, `centres/${location.data.slug}`)}
              class="group overflow-hidden rounded-2xl border border-border bg-white transition hover:shadow-soft"
            >
              {
                location.data.image && (
                  <div class="relative aspect-[16/10] overflow-hidden bg-brand-deep">
                    <img
                      src={location.data.image}
                      alt=""
                      class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]"
                      loading="lazy"
                    />
                    <div
                      class="absolute inset-0 bg-gradient-to-t from-brand-deep/80 via-transparent to-transparent"
                      aria-hidden="true"
                    />
                  </div>
                )
              }
              <div class="p-7">
                <div class="flex items-center justify-between gap-3">
                  <h2 class="font-display text-2xl font-semibold">
                    {location.data.city}
                  </h2>
                  <span
                    class:list={[
                      'text-xs font-semibold uppercase tracking-[0.12em]',
                      location.data.verification === 'verified'
                        ? 'text-accent'
                        : 'text-muted',
                    ]}
                  >
                    {location.data.verification === 'verified'
                      ? ui.common.verified
                      : ui.common.needsConfirmation}
                  </span>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-muted">
                  {tLocalized(location.data.summary, locale)}
                </p>
                {
                  location.data.address && (
                    <p class="mt-4 text-sm font-medium text-primary" dir="auto">
                      {location.data.address}
                    </p>
                  )
                }
                {
                  location.data.phone && (
                    <p class="mt-2 text-sm font-semibold text-accent" dir="ltr">
                      {location.data.phone}
                    </p>
                  )
                }
              </div>
            </a>
          ))
        }
      </div>
    </Container>
  </section>
</BaseLayout>
