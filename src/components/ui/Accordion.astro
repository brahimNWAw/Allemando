---
interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-border border-y border-border" data-accordion>
  {
    items.map((item, index) => (
      <details class="group py-5" open={index === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-semibold text-primary marker:content-none [&::-webkit-details-marker]:hidden">
          <span>{item.question}</span>
          <span
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-border text-muted transition group-open:rotate-45 group-open:border-accent group-open:text-accent"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p class="mt-3 max-w-3xl text-base leading-relaxed text-muted">
          {item.answer}
        </p>
      </details>
    ))
  }
</div>
