---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
  class?: string;
}

const {
  eyebrow,
  title,
  lead,
  align = 'left',
  tone = 'dark',
  class: className = '',
} = Astro.props;
---

<div
  class:list={[
    'max-w-2xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
>
  {
    eyebrow && (
      <p
        class:list={[
          'mb-3 text-xs font-semibold uppercase tracking-[0.18em]',
          tone === 'light' ? 'text-highlight' : 'text-accent',
        ]}
      >
        {eyebrow}
      </p>
    )
  }
  <h2
    class:list={[
      'text-balance text-[1.75rem] leading-tight sm:text-4xl lg:text-[2.75rem]',
      tone === 'light' ? 'text-white' : 'text-primary',
    ]}
  >
    {title}
  </h2>
  {
    lead && (
      <p
        class:list={[
          'mt-4 text-base leading-relaxed sm:text-lg',
          tone === 'light' ? 'text-white/80' : 'text-muted',
        ]}
      >
        {lead}
      </p>
    )
  }
</div>
