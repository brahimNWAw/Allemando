---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { getUi } from '../../i18n/ui';
import { localePath, whatsappUrl } from '../../utils/locale';
import type { Locale } from '../../config/site';
import { siteConfig } from '../../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const wa = whatsappUrl(
  siteConfig.contact.whatsappNumber,
  siteConfig.contact.whatsappMessage,
);
---

<section class="bg-white py-20 lg:py-24">
  <Container>
    <div
      class="reveal relative overflow-hidden bg-brand-deep px-8 py-12 text-white sm:px-12 lg:px-16"
    >
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_85%_20%,rgba(228,182,76,0.25),transparent_40%)]"
        aria-hidden="true"
      >
      </div>
      <div class="relative max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-highlight">
          {ui.nav.enroll}
        </p>
        <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">
          {ui.home.ctaTitle}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-white/80 sm:text-lg">
          {ui.home.ctaLead}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={localePath(locale, 'inscription')} size="lg">
            {ui.nav.enroll}
          </Button>
          {
            wa ? (
              <Button href={wa} variant="light" size="lg" external>
                WhatsApp
              </Button>
            ) : (
              <Button
                href={localePath(locale, 'contact')}
                variant="light"
                size="lg"
              >
                {ui.nav.contact}
              </Button>
            )
          }
        </div>
      </div>
    </div>
  </Container>
</section>
