---
import Container from '../ui/Container.astro';

const items = [
  { label: 'Niveaux CECRL', value: 'A1 → C1' },
  { label: 'Formats', value: 'Présentiel & distanciel' },
  { label: 'Orientation', value: 'Études & Ausbildung' },
  { label: 'Présence', value: 'Plusieurs villes au Maroc' },
];
---

<section class="border-b border-border bg-white">
  <Container class="grid gap-6 py-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      items.map((item) => (
        <div class="reveal">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted">
            {item.label}
          </p>
          <p class="mt-2 font-display text-xl font-semibold text-primary">
            {item.value}
          </p>
        </div>
      ))
    }
  </Container>
</section>
